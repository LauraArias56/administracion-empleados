{
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run build && npm run build --prefix frontend",
  "outputDirectory": null,
  "functions": {
    "server.js": {
      "includeFiles": "frontend/dist/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/",
      "transforms": [
        { "type": "request.path", "op": "set", "args": "/api/$1" }
      ]
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/",
      "transforms": [
        { "type": "request.path", "op": "set", "args": "/$1" }
      ]
    }
  ]
}
