{
  "name": "administracion-empleados",
  "version": "1.0.0",
  "description": "API de administración de empleados: contratos, vacaciones e historial laboral",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:api": "playwright test",
    "pretest:api": "npm run build",
    "test:api:report": "playwright show-report",
    "check:endpoints": "node scripts/check-endpoint-coverage.js",
    "precheck:endpoints": "npm run build",
    "verify:persistence": "node scripts/verify-persistence.js",
    "preverify:persistence": "npm run build",
    "migrate:json": "node scripts/migrate-json.js",
    "premigrate:json": "npm run build",
    "typecheck:api": "tsc -p api-tests/tsconfig.json"
  },
  "dependencies": {
    "awilix": "13.0.5",
    "awilix-express": "11.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
